{
	"info": {
		"_postman_id": "futureschool-management-api-v2",
		"name": "FutureSchool Management System API (Complete Prototype Coverage)",
		"description": "Complete production-ready REST API collection for FutureSchool High School ERP Backend. Covers 100% of all features created in the frontend prototype across all 5 user roles (Admin, Principal, Teacher, Parent, Student).",
