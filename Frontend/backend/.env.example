DATABASE_USERNAME=futureschool
DATABASE_PASSWORD=your_secure_db_password_here

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
